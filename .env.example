# این فایل را کپی کنید به یک فایل جدید به نام ".env" (بدون پسوند دیگر) و
# مقادیر واقعی خودتان را جای متن‌های <...> بگذارید.
# فایل .env هرگز نباید به هیچ ریپازیتوری عمومی/گیت‌هاب آپلود شود
# (در .gitignore همین پروژه از قبل مستثنا شده است).

TELEGRAM_BOT_TOKEN=<توکن ربات تلگرام از BotFather>
TELEGRAM_CHANNEL_ID=<مثلا -1001234567890>
TELEGRAM_ADMIN_CHAT_ID=<chat_id شخصی شما برای هشدارها>

NOBITEX_PUBLIC_KEY=<کلید عمومی API نوبیتکس>
NOBITEX_PRIVATE_KEY=<کلید خصوصی API نوبیتکس>
NOBITEX_BASE_URL=https://testnetapiv2.nobitex.ir

RISK_MARGIN_USDT=1
LEVERAGE=10
